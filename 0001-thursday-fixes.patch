+  // "Next lock" — the first kickoff among this player's still-open picks,
+  // or among all open games if they have none yet.
+  function updateLockLine() {
+    const el = document.getElementById('lockLine');
+    if (!el || games.length === 0) return;
+    const now = new Date();
+    const isOpen = g => {
+      const t = new Date(g.gameTime);
+      return !Number.isNaN(t.getTime()) && now < t && g.status !== 'live' && g.status !== 'final';
+    };
+    const myIds = new Set(Object.keys(getCurrentWeekPicks()));
+    let pool = games.filter(g => isOpen(g) && myIds.has(g.id));
+    let mine = true;
+    if (pool.length === 0) { pool = games.filter(isOpen); mine = false; }
+    if (pool.length === 0) {
+      const anyGames = games.length > 0;
+      el.textContent = anyGames ? 'All games have kicked off — picks are locked' : '';
+      el.className = 'lock-line';
+      return;
+    }
+    pool.sort((a, b) => new Date(a.gameTime) - new Date(b.gameTime));
+    const first = new Date(pool[0].gameTime);
+    const ms = first - now;
+    const h = Math.floor(ms / 3600000), d = Math.floor(h / 24);
+    const rel = d >= 1 ? `${d}d ${h - d * 24}h` : h >= 1 ? `${h}h ${Math.floor((ms % 3600000) / 60000)}m` : `${Math.max(1, Math.floor(ms / 60000))}m`;
+    const when = first.toLocaleString('en-US', { weekday: 'short', hour: 'numeric', minute: '2-digit' });
